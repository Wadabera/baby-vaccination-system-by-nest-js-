# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Test and coverage output
coverage/
.nyc_output/

# Local configuration and secrets.
# `.env.example` files are committed deliberately; the real ones are not.
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
modern-system/.env
modern-system/.env.*
!modern-system/.env.example

# The frontend's production build settings are committed on purpose: they hold
# only the public Render URL, and Vite inlines them at build time. Committing
# them keeps the Vercel build reproducible instead of depending on a dashboard
# variable that is invisible in a pull request.
!modern-system/frontend/.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime uploads and generated cards
backend/uploads/
uploads/

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
