NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB Atlas (SRV connection string — no port number needed).
# Replace <user>, <password>, <cluster-host> and <dbname> with the values from
# your Atlas cluster's "Connect" dialog, then run `npm run seed`.
#
# Note: the password MUST be URL-encoded, so an '@' becomes %40. The Atlas UI
# shows the string already encoded when you copy it from the connect dialog.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority

# To use the local Docker database instead, replace the line above with:
#   MONGODB_URI=mongodb://localhost:27017/vaccination

JWT_SECRET=super-secret-key-123
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:3000

# Password given to every account created by `npm run seed`. Use one of the
# accepted symbols (@ $ ! % * ? &) and quote the value if you add a '#',
# because dotenv treats an unquoted '#' as the start of a comment.
SEED_PASSWORD=Vaccinate@2024