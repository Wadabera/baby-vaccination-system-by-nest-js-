{
  "$schema": "https://json.schemastore.org/swcrc",
  "sourceMaps": false,
  "module": {
    "type": "commonjs"
  },
  "exclude": [
    "\\.spec\\.ts$",
    "src/database/run-with-memory-db\\.ts$"
  ],
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "target": "es2023",
    "keepClassNames": true
  }
}
