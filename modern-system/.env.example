# The backend reads its configuration from backend/.env.
# This file is what the Docker Compose services and the frontend consume.

# Backend
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://admin:password123@mongodb:27017/vaccination?authSource=admin
JWT_SECRET=super-secret-key-123
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:3000

# Frontend. In development the Vite dev server proxies /api to the backend,
# so a relative path is enough and avoids CORS entirely.
#
# When deployed to Vercel this MUST be the absolute Render URL including the
# /api suffix, because the two services are then on different origins:
#   VITE_API_URL=https://your-backend.onrender.com/api
#
# Vite inlines this into the bundle at BUILD time, so it has to be set in the
# Vercel dashboard before deploying. Changing it later requires a redeploy.
VITE_API_URL=/api
VITE_APP_NAME=Infant Vaccination Management System

# Password assigned to every account created by `npm run seed`.
#
# The symbol must be one the API accepts (@ $ ! % * ? &). `#` is rejected by
# the password policy, and an unquoted `#` would additionally be read by
# dotenv as the start of a comment, silently truncating the value.
SEED_PASSWORD=Vaccinate@2024
